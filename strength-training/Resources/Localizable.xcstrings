    "Export a complete backup of your data as a JSON file for safekeeping or to transfer to another device. Restoring replaces all current data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export a complete backup of your data as a JSON file for safekeeping or to transfer to another device. Restoring replaces all current data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将完整数据导出为 JSON 文件保存或转移到其他设备。恢复会替换全部现有数据。"
          }
        }
      }
    },
    "Restore Backup?": {
      "localizations": {
